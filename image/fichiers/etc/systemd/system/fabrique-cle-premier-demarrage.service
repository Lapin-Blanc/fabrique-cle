[Unit]
Description=Fabrique-Clé : configuration au premier démarrage
ConditionPathExists=/var/lib/fabrique-cle/a-configurer
After=local-fs.target systemd-udev-settle.service systemd-vconsole-setup.service
Before=display-manager.service getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fabrique-cle-premier-demarrage
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutSec=0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
